; TrendRiderH1 - preset de ejemplo para el Strategy Tester de MetaTrader 5
; Colocar en <carpeta de datos>/MQL5/Presets/ y cargarlo desde la pestana Parametros.
;
; Formato: nombre=valor||inicio||paso||fin||optimizar(Y/N)
;
; Los parametros marcados con Y son los del PASO 1 (nucleo de la senal).
; Para el PASO 2 pon a N los del paso 1 con su mejor valor y activa
; InpSlAtrMult, InpTrailAtrMult e InpTrailLookback.
;
; ===== General =====
InpSignalTF=16385
InpMagic=20260728
InpComment=TrendRider
InpSlippagePoints=20
InpShowInfo=true
;
; ===== Filtro de tendencia =====
InpEmaFastPeriod=50||20||10||80||Y
InpEmaSlowPeriod=200||100||25||250||Y
InpEmaPrice=1
InpRequirePriceSide=true
;
; ===== Filtro de timeframe superior =====
InpHtfMode=1||0||1||3||N
InpHtfTF=16408
InpHtfEmaPeriod=50||20||10||100||N
;
; ===== Entrada: ruptura Donchian =====
InpBreakoutPeriod=20||10||5||55||Y
InpBreakoutOnClose=true
InpAllowLong=true
InpAllowShort=true
;
; ===== Filtro de fuerza =====
InpUseAdx=true
InpAdxPeriod=14||10||2||20||N
InpAdxMinLevel=20.0||15.0||5.0||35.0||N
;
; ===== Filtro de extension =====
InpUseExtFilter=true
InpMaxExtAtr=3.0||1.5||0.5||5.0||N
;
; ===== Riesgo =====
InpRiskMode=1
InpRiskBase=0
InpFixedLots=0.10
InpRiskPercent=1.0
InpMaxPositions=1
;
; ===== Stops y objetivos =====
InpAtrPeriod=14||10||2||20||N
InpSlAtrMult=2.0||1.0||0.5||4.0||N
InpTpAtrMult=0.0||0.0||1.0||6.0||N
;
; ===== Breakeven =====
InpUseBreakeven=true
InpBeTriggerAtr=1.0||0.5||0.5||2.5||N
InpBeOffsetAtr=0.1
;
; ===== Cierre parcial =====
InpUsePartial=true
InpPartialTriggerAtr=1.5||1.0||0.5||3.0||N
InpPartialPercent=50.0||25.0||25.0||75.0||N
;
; ===== Trailing =====
InpUseTrailing=true
InpTrailLookback=20||10||5||40||N
InpTrailAtrMult=3.0||1.5||0.5||5.0||N
InpTrailStartAtr=1.0||0.0||0.5||2.0||N
;
; ===== Filtros operativos =====
InpMaxSpreadPoints=30
InpUseTimeFilter=false
InpStartHour=7||0||1||12||N
InpEndHour=20||14||1||23||N
InpTradeMonday=true
InpTradeTuesday=true
InpTradeWednesday=true
InpTradeThursday=true
InpTradeFriday=true
InpFridayExitHour=0
InpCooldownBars=1||0||1||5||N
InpMaxTradesPerDay=0
InpMaxDailyLossPct=0.0
