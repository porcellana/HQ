{
  "name": "ecos-del-abismo",
  "private": true,
  "version": "0.0.4",
  "description": "RPG de mazmorreo por turnos inspirado en D&D 5e para móvil (Android/PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "@capacitor/cli": "^8.6.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1"
  }
}
